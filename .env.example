POGOSCOUT_DATABASE_URL=sqlite+pysqlite:///../../data/pogoscout.sqlite3
POGOSCOUT_IMAGE_DIR=../../data/images
POGOSCOUT_FIXTURE_DIR=../../fixtures
# mock | http | disabled
POGOSCOUT_CLASSIFIER=mock
POGOSCOUT_ML_SERVICE_URL=http://localhost:9000
# Live ground demo: each session created on the demo page plays the drone, one hop per tick, each
# with the ground-classification service's latest reading. See the README, "Live ground demo".
POGOSCOUT_GROUND_SERVICE_URL=http://127.0.0.1:8765
POGOSCOUT_GROUND_HOP_INTERVAL_S=2.0
POGOSCOUT_GROUND_TIMEOUT_S=0.5
